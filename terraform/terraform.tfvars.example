project         = "your-gcp-project-id"
region          = "us-central1"
zone            = "us-central1-c"
billing_account = "XXXXXX-XXXXXX-XXXXXX"
org_id          = "000000000000"
domain          = "example.com"
bucket_prefix   = "myapp"

# UUIDs of existing Google Maps Platform API keys (see `gcloud services api-keys list`).
maps_api_key_uid               = "00000000-0000-0000-0000-000000000000"
additional_allowed_referrers   = ["*.example.org"]
localhost_api_key_uid          = "00000000-0000-0000-0000-000000000000"
additional_localhost_referrers = ["http://yourmachine.local:1234"]
